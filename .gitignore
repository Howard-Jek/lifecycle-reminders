coverage/

# Supabase CLI scratch (generated by `supabase start`)
supabase/.temp/
supabase/.branches/

# Generated by `npm run db:bundle` — regenerate rather than commit, so it
# can never drift from the migrations it is built from.
supabase/bundle.sql

# Added by `vercel link`. Broader than the `.env*.local` rule above, and it
# would swallow .env.example — the one env file that must stay committed,
# since it is the only documentation of what the app needs. Inert today
# because .env.example is already tracked, which is exactly the kind of rule
# that bites the next person rather than this one.
.env*
!.env.example

# Written by the CI dependency-scan step; never committed.
audit.json
